{
  "ai": {
    "provider": "deepseek",
    "model": "deepseek-v4-flash",
    "base_url": "https://api.deepseek.com",
    "api_key_env": "DEEPSEEK_API_KEY",
    "temperature": 0.3,
    "max_tokens": 8192,
    "throttle_sec": 1,
    "languages": [
      "zh",
      "en"
    ],
    "analysis_concurrency": 5,
    "enrichment_concurrency": 5
  },
  "processing": {
    "profiles_dir": "profiles",
    "default_profile": "tech-news",
    "profile_settings": {
      "tech-news": {
        "threshold": 7.0,
        "topic_dedup": true
      },
      "tech-blog": {
        "threshold": 4.0,
        "topic_dedup": false
      },
      "finance-news": {
        "threshold": 7.0,
        "topic_dedup": true
      }
    }
  },
  "sources": {
    "github": [
      {
        "name": "GitHub Trending",
        "url": "https://github.com/trending?since=daily",
        "enabled": true
      },
      {
        "name": "GitHub Trending (Weekly)",
        "url": "https://github.com/trending?since=weekly",
        "enabled": false
      },
      {
        "name": "Hacker News",
        "url": "https://news.ycombinator.com/rss",
        "enabled": true
      },
      {
        "name": "LWN.net",
        "url": "https://lwn.net/headlines/rss",
        "enabled": false
      },
      {
        "name": "Slashdot",
        "url": "https://rss.slashdot.org/Slashdot/slashdotMain",
        "enabled": true
      }
    ],
    "rss": [
      {
        "name": "TLDR",
        "url": "https://tldr.tech/tech/rss",
        "enabled": true
      },
      {
        "name": "The Hacker News",
        "url": "https://thehackernews.com/feeds/posts/default",
        "enabled": true
      },
      {
        "name": "Hacker News",
        "url": "https://news.ycombinator.com/rss",
        "enabled": true
      },
      {
        "name": "TechCrunch",
        "url": "https://techcrunch.com/feed/",
        "enabled": true
      },
      {
        "name": "Ars Technica",
        "url": "https://feeds.arstechnica.com/arstechnica/index",
        "enabled": true
      },
      {
        "name": "InfoQ",
        "url": "https://www.infoq.com/feed",
        "enabled": true
      }
    ],
    "custom": [
      {
        "name": "Medium Daily Digest",
        "url": "https://medium.com/feed/daily-digest",
        "enabled": false
      },
      {
        "name": "Dev.to",
        "url": "https://dev.to/feed",
        "enabled": false
      }
    ]
  },
  "webhook": {
    "enabled": false
  },
  "email": {
    "enabled": false,
    "smtp": {
      "host": "smtp.qq.com",
      "port": 465,
      "username": "",
      "password_env": "SMTP_PASSWORD",
      "use_ssl": true
    },
    "from_addr": "",
    "to_addrs": []
  },
  "output": {
    "dir": "output",
    "filename_format": "%Y-%m-%d.md",
    "archive": true
  },
  "schedule": {
    "mode": "fixed",
    "cron": "0 22 * * *",
    "timezone": "Asia/Shanghai"
  },
  "logging": {
    "level": "INFO",
    "file": "output/horizon.log"
  },
  "retry": {
    "max_attempts": 3,
    "backoff_sec": 5
  },
  "storage": {
    "type": "file",
    "path": "data/state.json"
  },
  "translation": {
    "enabled": false,
    "target_language": "zh",
    "preserve_original": true
  }
}
